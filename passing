<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Passing | Volleyball Academy</title>
    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #0b1020;
            color: white;
            line-height: 1.6;
        }

        /* NAVBAR */
        nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: #11182d;
            border-bottom: 1px solid #283454;
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h2 {
            color: #5ee7ff;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover {
            color: #5ee7ff;
        }

        /* HERO */
        .hero {
            min-height: 70vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px 20px;
            background:
                radial-gradient(circle at center, #18284c, #0b1020 70%);
        }

        .hero h1 {
            font-size: clamp(45px, 8vw, 90px);
            margin-bottom: 10px;
            color: #5ee7ff;
        }

        .hero p {
            max-width: 700px;
            font-size: 20px;
            color: #cbd5e1;
        }

        .button {
            display: inline-block;
            margin-top: 30px;
            padding: 14px 28px;
            background: #5ee7ff;
            color: #07101c;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
        }

        .button:hover {
            transform: scale(1.05);
        }

        /* SECTIONS */
        section {
            padding: 80px 8%;
        }

        section h2 {
            text-align: center;
            font-size: 40px;
            margin-bottom: 15px;
            color: #5ee7ff;
        }

        .subtitle {
            text-align: center;
            color: #9ca9c2;
            margin-bottom: 45px;
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 25px;
        }

        .card {
            background: #131c34;
            border: 1px solid #283454;
            border-radius: 14px;
            padding: 28px;
            transition: 0.25s;
        }

        .card:hover {
            transform: translateY(-7px);
            border-color: #5ee7ff;
        }

        .card h3 {
            color: #5ee7ff;
            margin-bottom: 12px;
            font-size: 23px;
        }

        .card p {
            color: #c7d0df;
        }

        .card ul {
            margin-left: 20px;
            color: #c7d0df;
        }

        /* ROTATION */
        .rotation-container {
            max-width: 900px;
            margin: auto;
        }

        /* 3 WIDE VOLLEYBALL COURT */
        .court {
            position: relative;
            width: 100%;
            max-width: 900px;
            height: 420px;
            margin: 40px auto;
            border: 5px solid white;
            background: #c9783b;

            display: grid;

            /* 3 positions across */
            grid-template-columns: repeat(3, 1fr);

            /* Front row + back row */
            grid-template-rows: repeat(2, 1fr);

            gap: 5px;
        }

        .zone {
            border: 2px solid rgba(255,255,255,0.7);
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            background: rgba(0,0,0,0.08);
        }

        .zone strong {
            font-size: 30px;
        }

        .front {
            background: rgba(255,255,255,0.08);
        }

        .rotation-note {
            text-align: center;
            max-width: 750px;
            margin: auto;
            color: #c7d0df;
        }

        /* TIPS */
        .tip {
            background: #182642;
            border-left: 5px solid #5ee7ff;
            padding: 20px;
            margin-top: 20px;
            border-radius: 5px;
        }

        /* FOOTER */
        footer {
            text-align: center;
            padding: 40px;
            background: #070b16;
            color: #77849c;
        }


        /* ============================= */
        /* 5-1 ROTATION TRAINER */
        /* ============================= */

        .five-one {
            margin-top: 70px;
        }

        .five-one h3 {
            text-align: center;
            color: #5ee7ff;
            font-size: 32px;
            margin-bottom: 10px;
        }

        .five-one-intro {
            text-align: center;
            color: #c7d0df;
            max-width: 780px;
            margin: 0 auto 30px;
        }

        .rotation-buttons,
        .phase-buttons {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .rotation-buttons {
            margin-bottom: 14px;
        }

        .phase-buttons {
            margin-bottom: 30px;
        }

        .rotation-buttons button,
        .phase-buttons button {
            border: 1px solid #283454;
            background: #131c34;
            color: white;
            padding: 12px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.2s;
        }

        .rotation-buttons button:hover,
        .phase-buttons button:hover {
            border-color: #5ee7ff;
            color: #5ee7ff;
            transform: translateY(-2px);
        }

        .rotation-buttons button.active,
        .phase-buttons button.active {
            background: #5ee7ff;
            color: #07101c;
            border-color: #5ee7ff;
        }

        .trainer-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 300px;
            gap: 25px;
            align-items: start;
        }

        .trainer-court-wrap {
            width: 100%;
        }

        .trainer-court {
            position: relative;
            width: 100%;
            max-width: 900px;
            height: 500px;
            margin: 0 auto;
            border: 5px solid white;
            border-radius: 4px;
            background:
                linear-gradient(to bottom,
                    transparent 49.2%,
                    rgba(255,255,255,0.95) 49.2%,
                    rgba(255,255,255,0.95) 50.8%,
                    transparent 50.8%),
                #c9783b;
            overflow: hidden;
            box-shadow: 0 12px 35px rgba(0,0,0,0.28);
        }

        /* attack line */
        .trainer-court::before,
        .trainer-court::after {
            content: "";
            position: absolute;
            left: 16.66%;
            right: 16.66%;
            height: 4px;
            background: rgba(255,255,255,0.9);
            z-index: 1;
        }

        .trainer-court::before {
            top: 30%;
        }

        .trainer-court::after {
            top: 70%;
        }

        .trainer-net {
            position: absolute;
            left: 0;
            right: 0;
            top: 50%;
            height: 9px;
            background: white;
            z-index: 3;
            transform: translateY(-50%);
            box-shadow: 0 0 0 2px rgba(0,0,0,0.12);
        }

        .court-label {
            position: absolute;
            z-index: 2;
            color: rgba(255,255,255,0.75);
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 1px;
            pointer-events: none;
        }

        .court-label.front-label {
            top: 3%;
            left: 50%;
            transform: translateX(-50%);
        }

        .court-label.back-label {
            bottom: 3%;
            left: 50%;
            transform: translateX(-50%);
        }

        .player {
            position: absolute;
            left: var(--x);
            top: var(--y);
            width: 28%;
            max-width: 170px;
            min-width: 105px;
            height: 92px;
            z-index: 10;
            border: 2px solid rgba(255,255,255,0.72);
            border-radius: 12px;
            background: rgba(7,16,28,0.82);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            cursor: pointer;
            transform: translate(-50%, -50%);
            transition:
                left 0.65s ease,
                top 0.65s ease,
                transform 0.2s ease,
                background 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease;
            backdrop-filter: blur(3px);
        }

        .player:hover {
            border-color: #5ee7ff;
            background: rgba(20,40,65,0.92);
            transform: translate(-50%, -50%) scale(1.04);
        }

        .player.selected {
            border: 3px solid #5ee7ff;
            background: rgba(94,231,255,0.22);
            box-shadow: 0 0 22px rgba(94,231,255,0.32);
        }

        .player-content {
            line-height: 1.25;
        }

        .player-number {
            display: block;
            font-size: 11px;
            color: #d9e2ef;
            margin-bottom: 2px;
        }

        .player-name {
            display: block;
            font-size: 22px;
            font-weight: bold;
            color: #ffffff;
        }

        .player-role {
            display: block;
            font-size: 11px;
            color: #d9e2ef;
            margin-top: 2px;
        }

        .role-panel {
            background: #131c34;
            border: 1px solid #283454;
            border-radius: 14px;
            padding: 25px;
            min-height: 330px;
        }

        .role-panel h4 {
            color: #5ee7ff;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .role-panel p {
            color: #c7d0df;
            margin-bottom: 15px;
        }

        .role-panel ul {
            margin-left: 20px;
            color: #c7d0df;
        }

        .role-panel li {
            margin-bottom: 6px;
        }

        .rotation-status {
            text-align: center;
            margin-top: 15px;
            color: #c7d0df;
            font-weight: bold;
        }

        .movement-box {
            margin-top: 25px;
            background: #182642;
            border-left: 5px solid #5ee7ff;
            padding: 20px;
            border-radius: 5px;
        }

        .movement-box h4 {
            color: #5ee7ff;
            margin-bottom: 8px;
        }

        .movement-box p {
            color: #c7d0df;
        }

        .trainer-help {
            text-align: center;
            color: #9ca9c2;
            font-size: 14px;
            margin-top: 14px;
        }

        .trainer-disclaimer {
            margin-top: 18px;
            color: #9ca9c2;
            font-size: 13px;
            text-align: center;
        }

        /* MOBILE */
        @media (max-width: 700px) {
            nav {
                flex-direction: column;
                gap: 12px;
            }

            nav ul {
                gap: 12px;
                flex-wrap: wrap;
                justify-content: center;
            }

            section {
                padding: 60px 5%;
            }


            .trainer-layout {
                grid-template-columns: 1fr;
            }

            .trainer-court {
                height: 390px;
            }

            .player {
                min-width: 82px;
                width: 30%;
                height: 70px;
            }

            .player-name {
                font-size: 17px;
            }

            .player-role,
            .player-number {
                font-size: 9px;
            }

            .role-panel {
                min-height: auto;
            }

            .court {
                height: 300px;
            }

            .zone {
                font-size: 14px;
            }

            .zone strong {
                font-size: 20px;
            }
        }
    

        .page-intro { text-align: center; padding: 55px 20px 10px; }
        .page-intro h1 { color: #5ee7ff; font-size: clamp(36px, 6vw, 64px); margin-bottom: 10px; }
        .page-intro p { color: #cbd5e1; max-width: 760px; margin: 0 auto; font-size: 18px; }
        .home-links { padding-top: 35px; }
        .home-card-link { display: block; color: inherit; text-decoration: none; height: 100%; }
        .home-card-link .card { height: 100%; }
        .home-card-link:focus-visible, nav a:focus-visible, .button:focus-visible { outline: 3px solid white; outline-offset: 4px; }
        .back-home { display: inline-block; margin: 25px 0 0; color: #5ee7ff; text-decoration: none; font-weight: bold; }
        @media (max-width: 700px) { .home-links { padding-top: 20px; } }

    </style>
</head>
